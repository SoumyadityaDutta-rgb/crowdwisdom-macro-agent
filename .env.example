# CrowdWisdomTrading Macroeconomics Agent
# API Credentials Configuration

# Apify API Token (Scraping economic calendars: CPI, FOMC, NFP)
# Get your token at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Apify Actor ID (Default: standard web scraper or custom calendar actor)
APIFY_CALENDAR_ACTOR_ID=epctex/trading-economics-scraper

# Tavily API Key (Macroeconomic news and sentiment ingestion)
# Get your key at: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Exa API Key
EXA_API_KEY=

# Optional: LLM API Key for advanced macro synthesis (Optional, fallback provided)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Pipeline Configuration
DAYS_LOOKBACK=180
DATABASE_PATH=data/database.sqlite
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
